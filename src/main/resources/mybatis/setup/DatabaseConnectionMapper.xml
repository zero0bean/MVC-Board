<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.studyhub.setup.mapper.DatabaseConnectionMapper">
    <select id="selectConnectionInfo"
            resultType="com.studyhub.setup.model.DatabaseConnectionInfo"
        >
        
        SELECT current_database() AS database_name,
                current_user AS database_user,
                current_setting('server_version') AS sever_version,
                LOCALTIMESTAMP AS checked_at
    </select>
</mapper>